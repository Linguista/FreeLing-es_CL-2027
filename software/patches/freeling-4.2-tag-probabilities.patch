+  ///////////////////////////////////////////////////////////////  
+  ///  log(exp(a)+exp(b)), with -infinity as log(0)
+  ///////////////////////////////////////////////////////////////  
+
+  static inline double log_add(double a, double b) {
+    if (a==-numeric_limits<double>::infinity()) return b;
+    if (b==-numeric_limits<double>::infinity()) return a;
+    return (a>b ? a+log1p(exp(b-a)) : b+log1p(exp(a-b)));
+  }
+
+
+  ///////////////////////////////////////////////////////////////  
+  ///  Forward-backward over the same states and probabilities the
+  ///  Viterbi search uses. Returns, for each word, the probability
+  ///  of each of its short tags given the whole sentence. Returns
+  ///  an empty vector if the sentence has no path with probability
+  ///  above zero.
+  ///////////////////////////////////////////////////////////////  
+
+  vector<map<wstring,double> > hmm_tagger::TagPosteriors(const sentence &se, const list<emission_states> &lemm) const {
+
+    const double NEG=-numeric_limits<double>::infinity();
+    size_t n=se.size();
+    vector<map<wstring,double> > post;
+    if (n==0 or lemm.size()!=n) return post;
+
+    // states and words by position
+    vector<vector<bigram> > st(n);
+    vector<sentence::const_iterator> wd(n);
+    size_t t=0;
+    sentence::const_iterator w=se.begin();
+    for (list<emission_states>::const_iterator e=lemm.begin(); e!=lemm.end(); e++,w++,t++) {
+      st[t].assign(e->begin(),e->end());
+      wd[t]=w;
+    }
+
+    // emission and transition (log) probabilities
+    vector<vector<double> > emm(n);
+    for (t=0; t<n; t++) {
+      emm[t].resize(st[t].size());
+      for (size_t k=0; k<st[t].size(); k++) emm[t][k]=ProbB_log(st[t][k],*wd[t]);
+    }
+    // tr[t][j][k]: from state j of word t-1 to state k of word t
+    vector<vector<vector<double> > > tr(n);
+    for (t=1; t<n; t++) {
+      tr[t].assign(st[t-1].size(), vector<double>(st[t].size(),NEG));
+      for (size_t j=0; j<st[t-1].size(); j++)
+        for (size_t k=0; k<st[t].size(); k++)
+          if (st[t-1][j].second==st[t][k].first)
+            tr[t][j][k]=ProbA_log(st[t-1][j],st[t][k],wd[t]);
+    }
+
+    // forward
+    vector<vector<double> > alpha(n), beta(n);
+    alpha[0].resize(st[0].size());
+    for (size_t k=0; k<st[0].size(); k++) alpha[0][k]=ProbPi_log(st[0][k])+emm[0][k];
+    for (t=1; t<n; t++) {
+      alpha[t].assign(st[t].size(),NEG);
+      for (size_t k=0; k<st[t].size(); k++) {
+        double s=NEG;
+        for (size_t j=0; j<st[t-1].size(); j++)
+          if (tr[t][j][k]!=NEG) s=log_add(s,alpha[t-1][j]+tr[t][j][k]);
+        alpha[t][k]=(s==NEG ? NEG : s+emm[t][k]);
+      }
+    }
+    double z=NEG;
+    for (size_t k=0; k<st[n-1].size(); k++) z=log_add(z,alpha[n-1][k]);
+    if (z==NEG or z!=z) return post;
+
+    // backward
+    beta[n-1].assign(st[n-1].size(),0.0);
+    for (t=n-1; t>0; t--) {
+      beta[t-1].assign(st[t-1].size(),NEG);
+      for (size_t j=0; j<st[t-1].size(); j++) {
+        double s=NEG;
+        for (size_t k=0; k<st[t].size(); k++)
+          if (tr[t][j][k]!=NEG) s=log_add(s,tr[t][j][k]+emm[t][k]+beta[t][k]);
+        beta[t-1][j]=s;
+      }
+    }
+
+    // probability of each short tag of each word
+    post.resize(n);
+    for (t=0; t<n; t++) {
+      for (size_t k=0; k<st[t].size(); k++) {
+        double lp=alpha[t][k]+beta[t][k]-z;
+        if (lp==NEG or lp!=lp) continue;
+        post[t][st[t][k].second]+=exp(lp);
+      }
+      for (map<wstring,double>::iterator p=post[t].begin(); p!=post[t].end(); p++) {
+        if (p->second>1.0) p->second=1.0;
+        if (p->second<0.0) p->second=0.0;
+      }
+    }
+    return post;
+  }
