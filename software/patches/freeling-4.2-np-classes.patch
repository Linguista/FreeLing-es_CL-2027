   void np::SetMultiwordAnalysis(sentence::iterator i, int fstate, const ner_status *st) const {
 
+    // es-CL: at the start of a sentence, a one-word name listed in
+    // <SentenceStartClasses> gets the reading given there, and nothing else
+    // applies: with "keep", its dictionary readings stay beside it and the
+    // tagger chooses (probabilitats.dat gives the odds); with "keep:V" (tag
+    // prefixes, separated by commas) only the readings whose tags begin so
+    // stay; without, they are dropped. The tag NP00000 leaves the class to
+    // the classifier.
+    if (st->initialNoun and i->get_n_words_mw()==1) {
+      std::map<wstring,start_reading>::const_iterator sc=start_classes.find(i->get_lc_form());
+      if (sc!=start_classes.end()) {
+        TRACE(3,L"   sentence-start reading "+sc->second.tag+L" for "+i->get_form());
+        if (sc->second.keep) {
+          i->copy_analysis(i->get_words_mw().front());
+          if (not sc->second.only.empty()) {
+            word::iterator a=i->begin();
+            while (a!=i->end()) {
+              bool take=false;
+              for (std::vector<wstring>::const_iterator p=sc->second.only.begin();
+                   p!=sc->second.only.end() and not take; ++p)
+                take=(a->get_tag().compare(0,p->size(),*p)==0);
+              if (take) ++a;
+              else a=i->erase(a);
+            }
+          }
+          i->set_analyzed_by(i->get_words_mw().front().get_analyzed_by());
+        }
+        i->add_analysis(analysis(sc->first,sc->second.tag));
+        i->set_analyzed_by(word::NER);
+        return;
+      }
+    }
+
+    // es-CL: the two rules below do not apply to a one-word name at the
+    // start of a sentence that is also an ordinary noun or adjective
+    // (FreeLing's own treatment is kept there) unless
+    // <ClassesAtSentenceStart> is yes.
+    bool apply_classes = classes_at_start or not (st->initialNoun and i->get_n_words_mw()==1);
+
+    // es-CL: a name whose class is fixed in <FixedClasses> takes it.
+    std::map<wstring,wstring>::const_iterator fc=fixed_classes.find(i->get_lc_form());
+    if (apply_classes and fc!=fixed_classes.end()) {
+      TRACE(3,L"   fixed class "+fc->second+L" for "+i->get_form());
+      i->add_analysis(analysis(fc->first,fc->second));
+      i->set_analyzed_by(word::NER);
+      i->lock_analysis();
+      return;
+    }
+
+    // es-CL: a one-word name the dictionary already knows as a proper noun
+    // of one of the classes in <DictionaryClasses> keeps that class (the
+    // first in the list that it has), with the dictionary's lemma; its other
+    // readings are dropped and the classifier does not see it.
+    if (apply_classes and not dict_classes.empty() and i->get_n_words_mw()==1) {
+      const word &w0 = i->get_words_mw().front();
+      for (std::vector<wstring>::const_iterator t=dict_classes.begin(); t!=dict_classes.end(); t++) {
+        for (word::const_iterator a=w0.begin(); a!=w0.end(); a++) {
+          if (a->get_tag()==*t) {
+            TRACE(3,L"   dictionary class "+(*t)+L" kept for "+w0.get_form());
+            i->add_analysis(analysis(a->get_lemma(),*t));
+            i->set_analyzed_by(word::NER);
+            i->lock_analysis();
+            return;
+          }
+        }
+      }
+    }
