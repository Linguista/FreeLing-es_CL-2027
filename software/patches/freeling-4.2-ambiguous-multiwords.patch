+  ///////////////////////////////////////////////////////////////  
+  ///  Given an *annotated* sentence, the (log) probability of its
+  ///  best tag sequence without the probabilities of the words
+  ///  themselves: transitions, and P(tag|word)/P(tag) for each
+  ///  word. P(word) is left out because it is a constant when the
+  ///  words are given, and would otherwise decide by itself between
+  ///  one multiword and the words it is made from.
+  ///////////////////////////////////////////////////////////////  
+
+  double hmm_tagger::SegmentationScore_log(const sentence &se) const {
+    double p=SequenceProb_log(se,0);
+    map<wstring,double>::const_iterator k;
+    for (sentence::const_iterator w=se.begin(); w!=se.end(); w++) {
+      k=PWord.find(w->get_lc_form());
+      p -= (k==PWord.end() ? probUnobserved : k->second);
+    }
+    return p;
+  }
+
+
+  ///////////////////////////////////////////////////////////////  
+  ///  Multiwords marked ambiguous (A) in the multiword file may be
+  ///  one word or the words they are made from ("o sea" the
+  ///  reformulator, or "o" and "sea"). For each one, left to right,
+  ///  the sentence is tagged both ways and the way whose best tag
+  ///  sequence fits better is kept. A multiword is only taken apart
+  ///  if every word it was made from has readings.
+  ///////////////////////////////////////////////////////////////  
+
+  void hmm_tagger::resolve_ambiguous_mw(sentence &se) const {
+
+    const double NEG=-numeric_limits<double>::infinity();
+    bool changes=false;
+    size_t pos=0;
+    sentence::iterator w=se.begin();
+    while (w!=se.end()) {
+
+      bool cand = w->is_multiword() and w->is_ambiguous_mw();
+      if (cand) {
+        const list<word> &cw=w->get_words_mw();
+        for (list<word>::const_iterator c=cw.begin(); c!=cw.end() and cand; c++)
+          cand = (c->get_n_analysis()>0);
+      }
+      if (not cand) { w++; pos++; continue; }
+
+      TRACE(3,L"Ambiguous multiword: "+w->get_form());
+
+      // the sentence with the multiword as one word
+      sentence sj(se);
+      tag_sentence(sj,false);
+      double pj=SegmentationScore_log(sj);
+
+      // the sentence with the multiword taken apart
+      sentence ss;
+      size_t i=0;
+      for (sentence::const_iterator x=se.begin(); x!=se.end(); x++,i++) {
+        if (i==pos) {
+          const list<word> &cw=x->get_words_mw();
+          for (list<word>::const_iterator c=cw.begin(); c!=cw.end(); c++) ss.push_back(*c);
+        }
+        else ss.push_back(*x);
+      }
+      ss.rebuild_word_index();
+      tag_sentence(ss,false);
+      double ps=SegmentationScore_log(ss);
+
+      TRACE(3,L"   as one word: "+util::double2wstring(pj)+L"; taken apart: "+util::double2wstring(ps));
+
+      // the weight the multiword file gives to its being one word
+      double pr=w->get_mw_prob();
+      if (pr<=0.0 or pr>=1.0) pr=0.5;
+      pj += log(pr);
+      ps += log(1.0-pr);
+
+      if (ps>pj and ps!=NEG and ps==ps) {
+        // take it apart in the sentence itself
+        list<word> cw=w->get_words_mw();
+        size_t nc=cw.size();
+        for (list<word>::iterator c=cw.begin(); c!=cw.end(); c++) {
+          c->user=w->user;
+          w=se.insert(w,*c);
+          w++;
+        }
+        w=se.erase(w);
+        pos+=nc;
+        changes=true;
+      }
+      else {
+        // it stays one word
+        w++; pos++;
+      }
+    }
+
+    if (changes) se.rebuild_word_index();
+  }
+
+
