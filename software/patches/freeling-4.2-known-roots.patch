+
+  //////////////////////////////////////////////////////////////////////////////////////////
+  // FreeLing es-CL 2027: whether a lowercase form has an accented i or u
+  // next to a, e or o (an h between them does not count), the written
+  // accent of a hiatus, which a form keeps whatever suffix follows it.
+  //////////////////////////////////////////////////////////////////////////////////////////
+
+  static bool hiatus_accent(const wstring &s) {
+    const wstring strong=L"aeo\u00e1\u00e9\u00f3";
+    for (size_t k=0; k<s.length(); k++) {
+      if (s[k]!=L'\u00ed' and s[k]!=L'\u00fa') continue;
+      size_t b=k, a=k;
+      if (b>0 and s[b-1]==L'h') b--;
+      if (a+1<s.length() and s[a+1]==L'h') a++;
+      if (b>0 and strong.find(s[b-1])!=wstring::npos) return true;
+      if (a+1<s.length() and strong.find(s[a+1])!=wstring::npos) return true;
     }
+    return false;
   }
 
 
