## This is the configuration file for 'basic' NE recognizer.
## Configuration files for B-I-O NE recognizer can be 
## found (if available) in nerc/nerc/ner-ab-*.dat
<Type>
basic
</Type>

## list of words that may be included in a Named Entity
## e.g.  "Banco de España"  "Pedro Villacasas de la Morena"
<FunctionWords>
el
la
los
las
un
una
unos
unas
de
del
por
para
&
d'
</FunctionWords>
## Punctuation mark tags after which a capitalized word
## may be indicating just a sentence (or clause) beginning
<SpecialPunct>
Fpa
Fca
Fla
Fp
Fs
Fd
Fg
Fe
Fia
Fit
Faa
Fat
Fra
Frc
</SpecialPunct>
## Tag to be assigned to detected NEs
<NE_Tag>
NP00000
</NE_Tag>
<TitleLimit>
0
</TitleLimit>
<Affixes>
don PRE
doña PRE
sr.  PRE
sra. PRE
sras. PRE
sres. PRE
srs.  PRE
srta. PRE
jr. SUF
</Affixes>
<Ignore>
a 1
b 1
c 1
d 1
e 1
f 1
g 1
h 1
i 1
j 1
k 1
l 1
m 1
n 1
ñ 1
o 1
p 1
q 1
r 1
s 1
t 1
u 1
v 1
w 1
x 1
y 1
z 1
</Ignore>
<Names>
amara
asad
blanca
blanco
bruce
carmen
china
corriere
giro
herrera
junta
mayor
miró
parís
pelé
piqué
riera
rojo
soler
time
times
unió
zapatero
miren
</Names>
<SplitMultiwords>
no
</SplitMultiwords>

## ----------------------------------------------------------------------
## FreeLing es-CL 2027: the name classes (decided 261110d).
## Read only by FreeLing 4.2 with the name-class change
## (software/patches/freeling-4.2-np-classes.patch); FreeLing without it
## skips these sections.
## This file: written texts (CODICACH): the fixed and dictionary classes
## apply inside a sentence; at its start a word that is also a common
## noun or an adjective is left to FreeLing.
##
## DictionaryClasses: a one-word name whose dictionary entry has one of
## these proper-noun tags keeps it, in this order, with the dictionary's
## lemma; the classifier is not asked.
<DictionaryClasses>
NP00G00 NP00SP0 NP00O00 NP00V00
</DictionaryClasses>
## ClassesAtSentenceStart: yes, the classes also apply at the start of a
## sentence (a line of transcribed speech); no, a word there that is also
## a common noun or an adjective is left to FreeLing.
<ClassesAtSentenceStart>
no
</ClassesAtSentenceStart>
## FixedClasses: form tag. The name, in lower case with its words joined
## by _, always gets this tag, whatever the classifier would say.
